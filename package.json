{
  "name": "securo-mobile",
  "version": "0.1.0",
  "description": "Native mobile and desktop client for self-hosted Securo personal finance",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/securo-finance/securo-mobile",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/securo-finance/securo-mobile.git"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "securo",
    "tauri",
    "android",
    "windows",
    "desktop",
    "personal-finance",
    "self-hosted",
    "homelab"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "frontend:prepare": "node scripts/prepare-frontend.mjs",
    "frontend:stage": "node scripts/stage-frontend.mjs",
    "android:configure": "node scripts/configure-android.mjs",
    "artifacts:package": "node scripts/package-artifacts.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.27.7"
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2"
  }
}
