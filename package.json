{
  "name": "securo-client",
  "version": "0.2.2",
  "description": "Native mobile and desktop client for self-hosted Securo personal finance",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/Marcelo-maga/securo-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcelo-maga/securo-client.git"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "securo",
    "tauri",
    "android",
    "windows",
    "desktop",
    "personal-finance",
    "self-hosted",
    "homelab"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "desktop:build": "tauri build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "frontend:prepare": "node scripts/prepare-frontend.mjs",
    "frontend:stage": "node scripts/stage-frontend.mjs",
    "android:configure": "node scripts/configure-android.mjs",
    "artifacts:package": "node scripts/package-artifacts.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2",
    "semantic-release": "^25.0.9"
  },
  "dependencies": {
    "@tauri-apps/plugin-http": "^2"
  }
}
