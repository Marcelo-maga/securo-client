{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Securo",
  "version": "0.1.0",
  "identifier": "com.securo.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Securo",
        "width": 800,
        "height": 600,
        "url": "index.html",
        "visible": false
      },
      {
        "label": "config",
        "title": "Configure Securo",
        "width": 800,
        "height": 600,
        "url": "config/config.html",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
