{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the app and configuration windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/**" },
        { "url": "http://*/**" },
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    }
  ]
}
